<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickNotes" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.QuickNotes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="postSplashScreenTheme">@style/Theme.QuickNotes</item>
    </style>
</resources>
